{
    "name": "@pepperdash/ch5-crcomlib-lite",
    "version": "2.8.0",
    "description": "Crestron HTML5 (CH5) Components Library modified by PepperDash",
    "repository": {
        "type": "git",
        "url": "https://github.com/PepperDash/CH5ComponentLibrary"
    },
    "keywords": [
        "ch5",
        "CrComLib"
    ],
    "type": "module",
    "types": "dist/index.d.ts",
    "main": "dist/ch5-crcomlib-lite.js",
    "module": "dist/ch5-crcomlib-lite.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/ch5-crcomlib-lite.js"
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "build": "tsc && vite build",
        "test": "vitest run",
        "lint": "eslint . --ext .ts",
        "eslint": "eslint . --ext .ts"
    },
    "author": "Crestron - modified by PepperDash",
    "license": "SEE LICENSE IN LICENSE.txt",
    "dependencies": {
        "i18next": "^21.6.3",
        "lodash": "^4.17.21",
        "rxjs": "^7.3.0"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.5",
        "@types/node": "^24.19.4",
        "@typescript-eslint/eslint-plugin": "^8.67.0",
        "@typescript-eslint/parser": "^8.67.0",
        "eslint": "^8.49.0",
        "jsdom": "^29.1.1",
        "typescript": "^5.1.6",
        "vite": "^8.2.2",
        "vite-plugin-dts": "^3.9.1",
        "vitest": "^5.1.2"
    },
    "files": [
        "LICENSE.txt",
        "readme.md",
        "dist"
    ],
    "engines": {
        "node": ">=20.4.0"
    }
}
